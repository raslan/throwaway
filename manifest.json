{
  "manifest_version": 3,
  "name": "PersonaShell",
  "version": "4.1.5",
  "description": "PersonaShell creates throwaway identities and fills account forms quickly for clean onboarding.",
  "short_name": "PersonaShell",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "PersonaShell",
    "default_popup": "index.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.ts"
  },
  "content_scripts": [
    {
      "js": ["content-script.ts"],
      "matches": ["https://*/*", "http://*/*"],
      "all_frames": true
    }
  ],
  "permissions": ["activeTab", "scripting", "contextMenus", "storage"]
}
